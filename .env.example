# Copy this file to .env in this folder, then paste your key in.
#
#   cp .env.example .env
#
# Every agent in this project reaches gpt-6-luna through the Portkey gateway with
# this key. It is read by backend/llm.py and is never printed, logged, or written
# to the audit trail. The real .env is gitignored.

PORTKEY_API_KEY=your-portkey-api-key-here
